{
  "name": "@scooper4711/pixels-ble",
  "version": "0.1.0",
  "description": "Pixels dice BLE connection library",
  "type": "module",
  "main": "dist/umd/index.global.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/umd/index.global.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "test": "vitest --run",
    "lint": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "pixels",
    "dice",
    "bluetooth",
    "ble",
    "web-bluetooth"
  ],
  "author": "scooper4711",
  "license": "MIT",
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.21",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
